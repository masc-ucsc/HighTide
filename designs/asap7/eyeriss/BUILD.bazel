load("//:defs.bzl", "hightide_design")

filegroup(
    name = "sram_lefs",
    srcs = glob(["sram/lef/*.lef"]),
)

filegroup(
    name = "sram_libs",
    srcs = glob(["sram/lib/*.lib"]),
)

# Eyeriss v2 sparse-CNN accelerator, ASIC top TOP. The 193 logical memories
# expand to 1040 physical depth banks with the current ASAP7 SRAM interfaces.
# See designs/src/eyeriss/DECISIONS.md for the banking correction.
hightide_design(
    name = "eyeriss",
    top = "TOP",
    platform = "asap7",
    verilog_files = ["//designs/src/eyeriss:rtl_asap7"],
    sources = {
        "SDC_FILE": [":constraint.sdc"],
        "ADDITIONAL_LEFS": [":sram_lefs"],
        "ADDITIONAL_LIBS": [":sram_libs"],
    } | {
        hook: [":timing.tcl"]
        for hook in [
            "PRE_FLOORPLAN_TCL",
            "PRE_MACRO_PLACE_TCL",
            "PRE_TAPCELL_TCL",
            "PRE_PDN_TCL",
            "PRE_GLOBAL_PLACE_SKIP_IO_TCL",
            "PRE_IO_PLACEMENT_TCL",
            "PRE_GLOBAL_PLACE_TCL",
            "PRE_RESIZE_TCL",
            "PRE_DETAIL_PLACE_TCL",
            "PRE_CTS_TCL",
            "PRE_GLOBAL_ROUTE_TCL",
            "PRE_DETAIL_ROUTE_TCL",
            "PRE_FILLCELL_TCL",
            "PRE_DENSITY_FILL_TCL",
            "PRE_FINAL_REPORT_TCL",
        ]
    },
    arguments = {
        "SYNTH_HIERARCHICAL": "1",
        # The 1040-bank implementation cannot fit RTLMP's nested cluster
        # regions at max level 2 (MPL-0040 in ClusterGroup_0_0). A single
        # clustering level legalizes at the same 30% core utilization and
        # 5-um macro halo; it does not relax spacing or enlarge the die.
        "RTLMP_MAX_LEVEL": "1",
        "CORE_UTILIZATION": "30",
        "PLACE_DENSITY_LB_ADDON": "0.20",
        "MACRO_PLACE_HALO": "5 5",
        "TNS_END_PERCENT": "100",
        # ODB-1200 in CTS repair_timing — split_load load-list invalidation
        # trips InsertBufferBeforeLoads on the GLB iact SRAMs (OpenROAD #75).
        # Drop split_load from the move sequence rather than the heavier
        # SKIP_CTS_REPAIR_TIMING — keeps the rest of repair_timing active so
        # the small (~40 ps) hold violations get patched too.
        # Post-GRT repair_timing on the Psum spad/SRAM write paths makes
        # ~5 ps of slack progress per iteration on the 193-macro design,
        # which never converges in reasonable time.  Skip the incremental
        # + last-gasp repair passes.
        "SKIP_INCREMENTAL_REPAIR": "1",
        "SKIP_LAST_GASP": "1",
    },
)
