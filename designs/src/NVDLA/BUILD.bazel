# NVDLA shared RTL (hermetic vmod spec-build).
#
# All 5 partitions (a, c, m, o, p) compile against the same vmod tree.
# Per verilog.mk, only vmod/{rams/synth, vlibs, nvdla} + macros.v are
# fed to synthesis; vmod/rams/{model,fpga} are simulation-only.
#
# vmod/ is the *output* of NVDLA's spec build (`tmake -build vmod` over the
# parameterized nvdla/hw nv_small source).  The :gen_vmod genrule runs that
# build hermetically under Bazel — replacing the retired dev/setup.sh + its
# legacy downloads — with modern, reproducible tools: system perl + the
# vendored pure-perl modules (dev/perl_lib: YAML + XML::Simple), rules_python's
# python3, and rules_java's JDK (SystemC / JDK11 / perl-5.10 / python-2.7 are
# NOT required — the output reproduces byte-for-byte).  cfgrom is swapped for
# the pre-baked NV_NVDLA_cfgrom_REPLACE.v.
#
# SRAM patching is the committed-override layer (macros.v FakeRAM bridge +
# dev/generated/sram_ff FF stubs), same pattern as bp_processor — the generated
# vmod's rams instantiate RAMDP_*/RAMPDP_* which macros.v maps to fakeram_*.

load("//designs/src/NVDLA:vmod_files.bzl", "VMOD_FILES")

# Hermetic NVDLA vmod spec-build.  Copies the pinned nvdla/hw source to a
# writable tree, runs tmake with modern tools, and emits the 546-file vmod
# (cfgrom substituted, .vcp cpp-intermediates dropped).
genrule(
    name = "gen_vmod",
    srcs = [
        "@nvdla_hw_src//:all",
        "@nvdla_hw_src//:tools/bin/tmake",
        "dev/tree.make",
        "dev/cpp.sh",
        "dev/eperl-portable.patch",
        "dev/NV_NVDLA_cfgrom_REPLACE.v",
    ] + glob(["dev/perl_lib/**/*.pm", "dev/perl_lib/**/*.ini"]),
    outs = ["vmod/" + f for f in VMOD_FILES],
    toolchains = [
        "@rules_python//python:current_py_toolchain",
        "@bazel_tools//tools/jdk:current_java_runtime",
    ],
    cmd = """
set -e
export PATH="/usr/bin:/bin:$$PATH"
PY3=$$(readlink -f $(PYTHON3))
JAVABIN=$$(readlink -f $(JAVA))
SRCROOT=$$(dirname $$(dirname $$(dirname $$(readlink -f $(execpath @nvdla_hw_src//:tools/bin/tmake)))))
TREEMAKE=$$(readlink -f $(execpath dev/tree.make))
CFGROM=$$(readlink -f $(execpath dev/NV_NVDLA_cfgrom_REPLACE.v))
CPPWRAPPER=$$(readlink -f $(execpath dev/cpp.sh))
PERLLIBROOT=$$(dirname $$(readlink -f $(execpath dev/perl_lib/YAML.pm)))
WORK=$$(pwd)/_nvdla_vmod_work
rm -rf "$$WORK"; mkdir -p "$$WORK"
cp -rL "$$SRCROOT"/. "$$WORK"/
chmod -R u+w "$$WORK"
patch -d "$$WORK" -p1 < $(execpath dev/eperl-portable.patch)
cp "$$TREEMAKE" "$$WORK/tree.make"
cp "$$CPPWRAPPER" "$$WORK/tools/bin/hightide_cpp"
chmod +x "$$WORK/tools/bin/hightide_cpp"
export NVDLA_CPP="$$WORK/tools/bin/hightide_cpp"
export PERL5LIB="$$PERLLIBROOT" XML_SIMPLE_PREFERRED_PARSER=XML::SAX::PurePerl
export PYTHON="$$PY3" JAVA="$$JAVABIN"
( cd "$$WORK" && PATH="$$(dirname $$PY3):$$(dirname $$JAVABIN):$$PATH" perl ./tools/bin/tmake -build vmod ) >&2
rm -f "$$WORK/outdir/nv_small/vmod/nvdla/cfgrom/"*
cp "$$CFGROM" "$$WORK/outdir/nv_small/vmod/nvdla/cfgrom/NV_NVDLA_cfgrom.v"
mkdir -p $(RULEDIR)/vmod
cp -rL "$$WORK/outdir/nv_small/vmod/." $(RULEDIR)/vmod/
find $(RULEDIR)/vmod -name '*.vcp' -delete
rm -rf "$$WORK"
""",
)

# Header include files (generated).
filegroup(
    name = "include",
    srcs = ["vmod/" + f for f in VMOD_FILES if f.endswith(".vh") and (
        f.startswith("include/") or f.startswith("vlibs/")
    )],
    visibility = ["//visibility:public"],
)

# Synthesis RTL: the generated vmod synth subset + committed FakeRAM layer.
# (matches the retired glob: rams/synth, vlibs, nvdla/**; plus macros.v and the
# behavioural FF stubs for the sub-CACTI memories.)
filegroup(
    name = "rtl_release",
    srcs = ["vmod/" + f for f in VMOD_FILES if f.endswith(".v") and (
        f.startswith("rams/synth/") or
        f.startswith("vlibs/") or
        f.startswith("nvdla/")
    )] + glob(["dev/generated/sram_ff/*.v"]) + ["macros.v"],
    visibility = ["//visibility:public"],
)

alias(
    name = "rtl",
    actual = ":rtl_release",
    visibility = ["//visibility:public"],
)
