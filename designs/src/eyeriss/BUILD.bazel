# Assemble the upstream RTL with physical-bank wrappers for each technology.
load("@rules_python//python:defs.bzl", "py_binary")

py_binary(
    name = "generate_rtl",
    srcs = ["dev/generate_rtl.py"],
    main = "dev/generate_rtl.py",
)

[
    genrule(
        name = "gen_eyeriss" if platform == "asap7" else "gen_eyeriss_" + platform,
        srcs = [
            "@eyeriss_src//:src_v",
            "dev/macros_template.v",
            "dev/generated/fakeram_" + platform + ".cfg",
        ],
        outs = ["eyeriss.v" if platform == "asap7" else "eyeriss_" + platform + ".v"],
        tools = [":generate_rtl"],
        cmd = "$(location :generate_rtl) --cfg $(location dev/generated/fakeram_" + platform + ".cfg) " +
              "--template $(location dev/macros_template.v) --out $@ $(locations @eyeriss_src//:src_v)",
    )
    for platform in ["asap7", "nangate45", "sky130hd"]
]

[
    alias(
        name = "rtl_" + platform,
        actual = ":gen_eyeriss" if platform == "asap7" else ":gen_eyeriss_" + platform,
        visibility = ["//visibility:public"],
    )
    for platform in ["asap7", "nangate45", "sky130hd"]
]

# Preserve the original ASAP7 assembly target for existing callers.
alias(
    name = "rtl",
    actual = ":rtl_asap7",
    visibility = ["//visibility:public"],
)
