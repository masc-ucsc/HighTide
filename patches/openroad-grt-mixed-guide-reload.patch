diff --git a/src/grt/src/GlobalRouter.cpp b/src/grt/src/GlobalRouter.cpp
--- a/src/grt/src/GlobalRouter.cpp
+++ b/src/grt/src/GlobalRouter.cpp
@@ -404,7 +404,15 @@
     // check term count due to 1-pin nets in multiple designs.
     if (!net->isSpecial() && net->getGuides().empty() && net->getTermCount() > 1
         && !net->isConnectedByAbutment()) {
-      return false;
+      // Physical signal routes need no guides in a mixed routed database.
+      // Via-only stacks can be pin access for a still-unrouted net; retain
+      // the guide requirement for those rather than accepting any dbWire.
+      uint32_t wire_count = 0;
+      uint32_t via_count = 0;
+      net->getWireCount(wire_count, via_count);
+      if (net->getWire() == nullptr || wire_count == 0) {
+        return false;
+      }
     }
   }
   return true;
