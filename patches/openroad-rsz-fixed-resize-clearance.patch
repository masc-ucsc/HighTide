+bool Opendp::canResizeCell(odb::dbInst* inst, odb::dbMaster* master) const
+{
+  odb::Rect bbox;
+  master->getPlacementBoundary(bbox);
+  inst->getTransform().apply(bbox);
+  bbox.moveDelta(-core_.xMin(), -core_.yMin());
+  const auto sites = grid_->gridCovering(bbox);
+  for (GridY y = sites.ylo; y < sites.yhi; ++y) {
+    for (GridX x = sites.xlo; x < sites.xhi; ++x) {
+      const Pixel* pixel = grid_->gridPixel(x, y);
+      if (pixel == nullptr || !pixel->is_valid) {
+        return false;
+      }
+      const Node* fixed = pixel->cell;
+      if (fixed && fixed->isFixed() && fixed->getDbInst() != inst) {
+        return false;
+      }
+      const Node* padding = pixel->padding_reserved_by;
+      if (padding && padding->getDbInst() != inst) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
