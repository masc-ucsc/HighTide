+TEST(FixedResizeTest, RejectsInteriorFixedOverlapWithoutMutation)
+{
+  std::unique_ptr<odb::dbDatabase, decltype(&odb::dbDatabase::destroy)> db(
+      odb::dbDatabase::create(), &odb::dbDatabase::destroy);
+  utl::Logger logger;
+  auto* tech = odb::dbTech::create(db.get(), "tech");
+  auto* lib = odb::dbLib::create(db.get(), "lib", tech);
+  auto* site = odb::dbSite::create(lib, "site");
+  site->setWidth(10);
+  site->setHeight(100);
+  site->setClass(odb::dbSiteClass::CORE);
+  site->setSymmetryY();
+  auto make_master = [&](const char* name, int width) {
+    auto* master = odb::dbMaster::create(lib, name);
+    master->setWidth(width);
+    master->setHeight(100);
+    master->setType(odb::dbMasterType::CORE);
+    master->setSite(site);
+    master->setSymmetryX();
+    master->setSymmetryY();
+    master->setFrozen();
+    return master;
+  };
+  auto* small = make_master("small", 20);
+  auto* large = make_master("large", 80);
+  auto* chip = odb::dbChip::create(db.get(), tech);
+  auto* block = odb::dbBlock::create(chip, "top");
+  block->setDefUnits(1000);
+  block->setDieArea(odb::Rect(0, 0, 1000, 100));
+  block->setCoreArea(odb::Rect(0, 0, 1000, 100));
+  odb::dbRow::create(block, "row", site, 0, 0, odb::dbOrientType::R0,
+                     odb::dbRowDir::HORIZONTAL, 100, 10);
+  auto* cell = odb::dbInst::create(block, small, "resized");
+  cell->setLocation(100, 0);
+  cell->setPlacementStatus(odb::dbPlacementStatus::PLACED);
+  auto* fixed = odb::dbInst::create(block, small, "fixed");
+  fixed->setLocation(140, 0);
+  fixed->setPlacementStatus(odb::dbPlacementStatus::FIRM);
+  odb::dbBlockage::create(block, 500, 0, 520, 100);
+  Opendp dp(db.get(), &logger);
+  dp.initMacrosAndGrid();
+  EXPECT_TRUE(dp.canResizeCell(cell, small));
+  // The fixed cell is strictly inside the enlarged box, not at a corner.
+  EXPECT_FALSE(dp.canResizeCell(cell, large));
+  EXPECT_EQ(cell->getMaster(), small);
+  EXPECT_EQ(cell->getOrigin(), odb::Point(100, 0));
+  cell->setLocation(160, 0);  // Abutting the fixed cell is legal.
+  EXPECT_TRUE(dp.canResizeCell(cell, large));
+  cell->setOrient(odb::dbOrientType::MY);
+  cell->setLocation(160, 0);
+  EXPECT_FALSE(dp.canResizeCell(cell, large));
+  cell->setLocation(240, 0);
+  EXPECT_TRUE(dp.canResizeCell(cell, large));
+  cell->setOrient(odb::dbOrientType::R0);
+  cell->setLocation(460, 0);
+  EXPECT_TRUE(dp.canResizeCell(cell, small));
+  EXPECT_FALSE(dp.canResizeCell(cell, large));
+  cell->setLocation(970, 0);
+  EXPECT_FALSE(dp.canResizeCell(cell, large));
+}
