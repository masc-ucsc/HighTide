diff --git a/src/rsz/test/clone_protection_common.tcl b/src/rsz/test/clone_protection_common.tcl
--- /dev/null
+++ b/src/rsz/test/clone_protection_common.tcl
@@ -0,0 +1,53 @@
+try {
+# Probe CloneMove vs CloneGenerator/Candidate behavior on high-fanout net.
+source "helpers.tcl"
+source "hi_fanout.tcl"
+set def_filename [make_result_file "move_diff_clone.def"]
+write_clone_test_def $def_filename NAND2_X4 30
+read_liberty Nangate45/Nangate45_typ.lib
+read_lef Nangate45/Nangate45.lef
+read_def $def_filename
+create_clock -period 0.1 clk1
+set_driving_cell -lib_cell BUF_X1 [all_inputs]
+set_max_fanout 200 [current_design]
+source Nangate45/Nangate45.vars
+source Nangate45/Nangate45.rc
+set_wire_rc -layer metal2
+estimate_parasitics -placement
+set_wire_rc -signal -layer $wire_rc_layer
+set_wire_rc -clock -layer $wire_rc_layer_clk
+set_dont_use $dont_use
+estimate_parasitics -placement
+report_worst_slack -max
+
+set block [ord::get_db_block]
+switch $::clone_protection_case {
+ input {set_dont_touch [get_nets clk_to_nand0]}
+ driver {set_dont_touch [get_cells nand_inst_0]}
+ loads {set_dont_touch [get_cells load*]}
+ output {set_dont_touch [get_nets net0]}
+ baseline {}
+ default {error "invalid case"}
+}
+proc topology {} {
+ set b [ord::get_db_block];set cells {};set nets {}
+ foreach i [$b getInsts] {lappend cells [list [$i getName] [[$i getMaster] getName] [$i getLocation] [$i isDoNotTouch]]}
+ foreach n [$b getNets] {
+  set pins {}
+  foreach pin [$n getITerms] {lappend pins [list [[$pin getInst] getName] [[$pin getMTerm] getName]]}
+  foreach pin [$n getBTerms] {lappend pins [list PORT [$pin getName]]}
+  lappend nets [list [$n getName] [lsort $pins] [$n isDoNotTouch]]
+ }
+ return [list [lsort $cells] [lsort $nets]]
+}
+set before [topology]
+set count [llength [$block getInsts]]
+repair_timing -setup -sequence "clone" -skip_last_gasp -repair_tns 100 -max_passes 20 -verbose
+set added [expr {[llength [$block getInsts]]-$count}]
+if {$::clone_protection_case eq "baseline"} {
+ if {$added <= 0} {error "control did not exercise cloning"}
+} elseif {[topology] ne $before} {error "rejected clone changed protected topology"}
+puts "pass"
+
+} on error {message opts} {puts stderr "$message\n[dict get $opts -errorinfo]";exit 1}
+exit 0
