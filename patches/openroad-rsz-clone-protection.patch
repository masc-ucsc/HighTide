diff --git a/src/rsz/src/move/CloneCandidate.cc b/src/rsz/src/move/CloneCandidate.cc
--- a/src/rsz/src/move/CloneCandidate.cc
+++ b/src/rsz/src/move/CloneCandidate.cc
@@ -133,6 +133,31 @@
 
 MoveResult CloneCandidate::applyClone()
 {
+  // Cloning changes more than the output net: each cloned input adds a
+  // terminal to its original net, and moved loads must be reconnectable.
+  // Check the complete edit before creating any instance or net. A candidate
+  // can outlive its generation, so recheck protection at application time.
+  if (resizer_.dontTouch(drvr_inst_)
+      || !resizer_.okToBufferNet(drvr_pin_)) {
+    return rejectedMove();
+  }
+  std::unique_ptr<sta::InstancePinIterator> input_iter{
+      resizer_.network()->pinIterator(drvr_inst_)};
+  while (input_iter->hasNext()) {
+    sta::Pin* pin = input_iter->next();
+    if (resizer_.network()->direction(pin)->isInput()) {
+      odb::dbNet* net = resizer_.dbNetwork()->flatNet(pin);
+      if (net != nullptr && net->isDoNotTouch()) {
+        return rejectedMove();
+      }
+    }
+  }
+  for (sta::Pin* load : moved_loads_) {
+    if (resizer_.dontTouch(load)) {
+      return rejectedMove();
+    }
+  }
+
   clone_inst_
       = resizer_.makeInstance(clone_cell_, "clone", parent_, clone_loc_);
   if (clone_inst_ == nullptr) {
