+std::vector<Shape::NodeColumn> Shape::indexNodeColumns(
+    const std::vector<std::unique_ptr<Node>>& nodes)
+{
+  std::vector<NodeColumn> columns;
+  for (std::size_t i = 0; i < nodes.size(); ++i) {
+    const int x = nodes[i]->getPoint().x();
+    if (columns.empty() || columns.back().x != x) {
+      columns.push_back({x, i, i + 1});
+    } else {
+      columns.back().end = i + 1;
+    }
+  }
+  return columns;
+}
