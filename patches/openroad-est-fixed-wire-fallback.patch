 using odb::dbModInst;
 
 namespace {
+// Fixed routes have no global guides. Keep their placement estimate available
+// to intermediate timing repair; final OpenRCX extraction replaces this
+// approximation with the realized wire RC. Inspect encoded paths because
+// dbNet::getWireType() can still report ROUTED for FIXED DEF wiring.
+bool hasOnlyFixedWire(odb::dbNet* net)
+{
+  auto* wire = net->getWire();
+  if (wire == nullptr || net->isSpecial() || net->getSigType().isSupply()) {
+    return false;
+  }
+  bool found = false;
+  odb::dbWireDecoder decoder;
+  decoder.begin(wire);
+  for (auto opcode = decoder.next(); opcode != odb::dbWireDecoder::END_DECODE;
+       opcode = decoder.next()) {
+    if (opcode == odb::dbWireDecoder::PATH
+        || opcode == odb::dbWireDecoder::SHORT
+        || opcode == odb::dbWireDecoder::JUNCTION) {
+      if (decoder.getWireType() != odb::dbWireType::FIXED) {
+        return false;
+      }
+      found = true;
+    }
+  }
+  return found;
+}
