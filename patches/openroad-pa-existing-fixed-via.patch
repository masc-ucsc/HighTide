diff --git a/src/drt/src/pa/FlexPA_acc_point.cpp b/src/drt/src/pa/FlexPA_acc_point.cpp
--- a/src/drt/src/pa/FlexPA_acc_point.cpp
+++ b/src/drt/src/pa/FlexPA_acc_point.cpp
@@ -21,6 +21,7 @@
 #include "db/tech/frViaDef.h"
 #include "frBaseTypes.h"
 #include "frProfileTask.h"
+#include "frRegionQuery.h"
 #include "gc/FlexGC.h"
 #include "odb/dbTransform.h"
 #include "odb/dbTypes.h"
@@ -1086,7 +1087,30 @@
     }
   }
   design_rule_checker.addPAObj(ps, owner);
-  design_rule_checker.addPAObj(via, owner);
+  // A fixed connection can already contain this exact access via. Checking
+  // a second copy would manufacture a same-net cut-spacing violation.
+  bool existing_access_via = false;
+  if (owner->typeId() == frcNet && static_cast<frNet*>(owner)->isFixed()) {
+    std::vector<frBlockObject*> nearby;
+    getDesign()->getRegionQuery()->queryDRObj(
+        via->getBBox(), via->getViaDef()->getCutLayerNum(), nearby);
+    for (auto* obj : nearby) {
+      if (obj->typeId() != frcVia) {
+        continue;
+      }
+      const auto* existing = static_cast<frVia*>(obj);
+      if (existing->hasNet() && existing->getNet() == owner
+          && existing->getViaDef() == via->getViaDef()
+          && existing->getOrigin() == via->getOrigin()
+          && existing->getOrient() == via->getOrient()) {
+        existing_access_via = true;
+        break;
+      }
+    }
+  }
+  if (!existing_access_via) {
+    design_rule_checker.addPAObj(via, owner);
+  }
   for (auto& apPs : ap->getPathSegs()) {
     design_rule_checker.addPAObj(&apPs, owner);
   }
