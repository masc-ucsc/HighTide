+std::vector<Node*> Shape::getNodes(
+    const std::vector<std::unique_ptr<Node>>& layer_nodes) const
+{
+  // sortNodes and overlap cleanup leave each layer ordered by x then y.
+  // Select inclusive rectangle intersections without a layer-wide R-tree.
+  std::vector<Node*> nodes;
+  auto column = std::lower_bound(
+      layer_nodes.begin(), layer_nodes.end(), shape_.xMin(),
+      [](const auto& node, int x) { return node->getPoint().x() < x; });
+  while (column != layer_nodes.end()
+         && (*column)->getPoint().x() <= shape_.xMax()) {
+    const int x = (*column)->getPoint().x();
+    const auto next = std::upper_bound(
+        column, layer_nodes.end(), x,
+        [](int value, const auto& node) { return value < node->getPoint().x(); });
+    auto node = std::lower_bound(
+        column, next, shape_.yMin(),
+        [](const auto& value, int y) { return value->getPoint().y() < y; });
+    for (; node != next && (*node)->getPoint().y() <= shape_.yMax(); ++node) {
+      // Match the ordered-set query's comparator-equivalence deduplication.
+      if (nodes.empty() || nodes.back()->compare(node->get()) != 0) {
+        nodes.push_back(node->get());
+      }
+    }
+    column = next;
+  }
+  return nodes;
+}
