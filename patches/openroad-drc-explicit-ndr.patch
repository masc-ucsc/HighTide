 proc fix_max_spacing { args } {
diff --git a/src/drt/test/current_db_drc.tcl b/src/drt/test/current_db_drc.tcl
--- a/src/drt/test/current_db_drc.tcl
+++ b/src/drt/test/current_db_drc.tcl
@@ -34,4 +34,26 @@
 if {$first ne [check_report repeated 1]} {error "Repeated DRC changed"}
 replace_route 0
 if {[check_report removed 0] ne ""} {error "Removed patch still present"}
+# Parallel edges 27 DBU apart satisfy the base 18 DBU spacing but violate
+# an explicit 36 DBU NDR. Default checks must remain unchanged after opt-in.
+set ndr [odb::dbTechNonDefaultRule_create [ord::get_db_block] test_ndr]
+foreach layer [[ord::get_db_tech] getLayers] {
+ if {[$layer getType] ne "ROUTING"} {continue}
+ set rule [odb::dbTechLayerRule_create $ndr $layer]
+ $rule setWidth [$layer getWidth]
+ $rule setSpacing [$layer getSpacing]
+ if {[$layer getName] eq "M2"} {$rule setSpacing 36}
+}
+[[ord::get_db_block] findNet moving] setNonDefaultRule $ndr
+$enc begin $wire
+$enc newPath [[ord::get_db_tech] findLayer M2] ROUTED
+$enc addPoint 1050 1045
+$enc addPoint 1400 1045
+$enc end
+if {[check_report ndr_default_before 0] ne ""} {error "Base-spacing fixture is not clean"}
+set report [make_result_file current_db_drc_ndr.drc]
+drt::check_drc -check_ndr -output_file $report
+set stream [open $report r];set text [read $stream];close $stream
+if {![string match {*Metal Spacing*} $text]} {error "NDR violation not detected: $text"}
+if {[check_report ndr_default_after 0] ne ""} {error "NDR option leaked into subsequent checks"}
 puts "pass"
