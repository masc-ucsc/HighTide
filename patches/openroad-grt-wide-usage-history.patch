+TEST_F(NDRUsageGuard, HeavyNDRUsageAndHistoryDoNotWrap)
+{
+  std::array<FrNet, 220> heavy;
+  graph.updateCap3D(1, 1, 0, EdgeDirection::Horizontal, 0);
+  graph.updateCap3D(1, 1, 0, EdgeDirection::Vertical, 0);
+  for (int i = 0; i < heavy.size(); ++i) {
+    auto* net
+        = odb::dbNet::create(block, ("heavy" + std::to_string(i)).c_str());
+    heavy[i].reset(net, true, 0, 3, 0, 0, 0, new std::vector<int8_t>{3});
+    graph.updateUsageH(1, 1, &heavy[i], 3);
+    graph.updateUsageV(1, 1, &heavy[i], 3);
+  }
+  EXPECT_EQ(graph.getUsageH(1, 1), 66000);
+  EXPECT_EQ(graph.getUsageV(1, 1), 66000);
+  EXPECT_LT(graph.getCapH(1, 1) - graph.getUsageH(1, 1), 0);
+  EXPECT_TRUE(graph.usageWithinLimitWithUniformNDR(1, 1, true, 660, 3));
+  EXPECT_FALSE(graph.usageWithinLimitWithUniformNDR(1, 1, true, 659, 3));
+  graph.addRedH(1, 1, 17);
+  EXPECT_EQ(graph.getUsageRedH(1, 1), 66017);
+  int max_adj = 0;
+  graph.InitLastUsage(1);
+  for (int round = 0; round < 30; ++round) {
+    graph.updateCongestionHistory(1, 0, false, max_adj);
+  }
+  EXPECT_EQ(graph.getLastUsageH(1, 1), 1980000);
+  EXPECT_EQ(graph.getLastUsageV(1, 1), 1980000);
+  EXPECT_EQ(max_adj, 1980000);
+  for (auto& net : heavy) {
+    graph.updateUsageH(1, 1, &net, -3);
+    graph.updateUsageV(1, 1, &net, -3);
+  }
+  EXPECT_EQ(graph.getUsageH(1, 1), 0);
+  EXPECT_EQ(graph.getNDROverflowH(1, 1), 0);
+}
+TEST_F(NDRUsageGuard, HistorySaturatesAndNegativeUsageFailsClosed)
+{
+  const int maximum = std::numeric_limits<int32_t>::max();
+  graph.addUsageH(1, 0, maximum - 100);
+  graph.InitLastUsage(1);
+  int max_adj = 0;
+  graph.updateCongestionHistory(1, 0, false, max_adj);
+  graph.updateCongestionHistory(1, 0, false, max_adj);
+  EXPECT_EQ(graph.getLastUsageH(1, 0), maximum);
+  graph.str_accu(0);
+  EXPECT_EQ(graph.getLastUsageH(1, 0), maximum);
+  graph.addUsageV(0, 1, -1);
+  EXPECT_EQ(graph.getUsageV(0, 1), -1);
+  EXPECT_FALSE(graph.usageWithinLimitWithUniformNDR(0, 1, false, 3300, 3));
+}
