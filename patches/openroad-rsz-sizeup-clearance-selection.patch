+bool Resizer::canReplaceCell(sta::Instance* inst,
+                            const sta::LibertyCell* replacement) const
+{
+  dbMaster* master = db_->findMaster(replacement->name().c_str());
+  if (!master) {
+    return false;
+  }
+  // Incremental pin access precedes final legalization. Check immutable
+  // neighbors and route reservations before selecting a resize candidate.
+  const auto source = estimate_parasitics_->getParasiticsSrc();
+  return (source != est::ParasiticsSrc::kGlobalRouting
+          && source != est::ParasiticsSrc::kDetailedRouting)
+         || opendp_->canResizeCell(db_network_->staToDb(inst), master);
+}
