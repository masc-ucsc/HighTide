diff --git a/src/rsz/test/sizeup_fixed_clearance.tcl b/src/rsz/test/sizeup_fixed_clearance.tcl
--- /dev/null
+++ b/src/rsz/test/sizeup_fixed_clearance.tcl
@@ -0,0 +1,53 @@
+try {
+source helpers.tcl
+read_liberty Nangate45/Nangate45_typ.lib
+# Model a legal library family whose electrical ordering is not width ordering.
+set f [open Nangate45/Nangate45.lef r];set lef [read $f];close $f
+set start [string first {MACRO BUF_X2
+} $lef]
+set finish [string first {END BUF_X2} $lef $start]
+set macro [string range $lef $start $finish]
+set wider [string map {{SIZE 0.76 BY} {SIZE 2.66 BY}} $macro]
+if {$macro eq $wider} {error "Fixture width replacement failed"}
+set lef [string replace $lef $start $finish $wider]
+set lef_file [make_result_file nonmonotonic.lef]
+set f [open $lef_file w];puts -nonewline $f $lef;close $f
+read_lef $lef_file
+read_def repair_setup1.def
+initialize_floorplan -die_area {0 0 40 1200} -core_area {0 0 40 1200} -site FreePDK45_38x28_10R_NP_162NW_34O
+source Nangate45/Nangate45.vars
+source Nangate45/Nangate45.rc
+source $tracks_file
+create_clock -period 0.1 clk
+set_propagated_clock clk
+[[ord::get_db_block] findInst u1] swapMaster [[ord::get_db] findMaster BUF_X32]
+detailed_placement
+set_wire_rc -resistance 0.0001 -capacitance 0.001
+set_routing_layers -signal $global_routing_layers
+global_route
+estimate_parasitics -global_routing
+set block [ord::get_db_block]
+set target [$block findInst u2]
+foreach i [$block getInsts] {if {$i ne $target} {$i setDoNotTouch true}}
+$target setOrient R0
+set before [[$target getMaster] getName]
+lassign [$target getOrigin] x y
+set small [[ord::get_db] findMaster BUF_X4]
+set obstacle [odb::dbInst_create $block [[ord::get_db] findMaster BUF_X1] fixed_neighbor]
+$obstacle setOrigin [expr {$x+[$small getWidth]}] $y
+$obstacle setPlacementStatus FIRM
+$obstacle setDoNotTouch true
+# Keep both replacement sizes eligible; isolate the physical-clearance decision.
+set_opt_config -limit_sizing_area 10 -limit_sizing_leakage 10
+set_dont_use [get_lib_cells CLKBUF*]
+set fixed_before [list [$obstacle getOrigin] [$obstacle getPlacementStatus] [$obstacle getMaster]]
+set count_before [llength [$block getInsts]]
+repair_timing -setup -sequence sizeup -skip_last_gasp -max_passes 1
+if {[[$target getMaster] getName] ne "BUF_X4"} {error "Did not select legal fallback BUF_X4"}
+if {[list [$obstacle getOrigin] [$obstacle getPlacementStatus] [$obstacle getMaster]] ne $fixed_before} {error "Fixed neighbor changed"}
+if {[llength [$block getInsts]] != $count_before} {error "Unexpected topology change"}
+set a [$target getBBox];set b [$obstacle getBBox]
+if {[$a xMin] < [$b xMax] && [$b xMin] < [$a xMax] && [$a yMin] < [$b yMax] && [$b yMin] < [$a yMax]} {error "Fallback overlaps fixed neighbor"}
+puts "pass"
+} on error {message opts} {puts stderr "$message\n[dict get $opts -errorinfo]";exit 1}
+exit 0
