 using odb::dbInst;
 using odb::dbMasterType;
 using odb::dbModInst;
+
+namespace {
+// Invalidation is idempotent: it needs the connected endpoints, not the
+// sorted/deduplicated PinSet built by connectedPinIterator on large nets.
+class InvalidateConnectedDelays final : public sta::PinVisitor
+{
+ public:
+  explicit InvalidateConnectedDelays(sta::dbSta* sta) : sta_(sta) {}
+  void operator()(const sta::Pin* pin) override
+  {
+    if (auto* graph = sta_->graph();
+        graph && !sta_->network()->isHierarchical(pin)) {
+      sta::Vertex* vertex;
+      sta::Vertex* bidirect_vertex;
+      graph->pinVertices(pin, vertex, bidirect_vertex);
+      if (vertex) {
+        sta_->delaysInvalidFrom(vertex);
+      }
+      if (bidirect_vertex) {
+        sta_->delaysInvalidFrom(bidirect_vertex);
+      }
+    }
+  }
+
+ private:
+  sta::dbSta* sta_;
+};
+}  // namespace
 
