-IRNetwork::NodeTree Shape::getNodeTree(const Node::NodeSet& nodes) const
+  // Preserve the ordered set's sequence and its first-inserted representative
+  // for comparator-equivalent nodes, without a tree allocation per node.
+  const Node::Compare compare;
+  std::stable_sort(nodes.begin(), nodes.end(), compare);
+  const auto last = std::unique(nodes.begin(), nodes.end(), [&](Node* a, Node* b) {
+    return !compare(a, b) && !compare(b, a);
+  });
+  nodes.erase(last, nodes.end());
+  return nodes;
+}
