diff --git a/src/drt/test/fixed_wire_short_via_escape.tcl b/src/drt/test/fixed_wire_short_via_escape.tcl
--- /dev/null
+++ b/src/drt/test/fixed_wire_short_via_escape.tcl
@@ -0,0 +1,19 @@
+# Existing fixed vias need no fabricated long escape through other wires.
+source "helpers.tcl"
+read_lef "../../psm/test/asap7/asap7_tech_1x_201209.lef"
+read_lef "fixed_wire_short_via_escape.lef"
+read_def "fixed_wire_short_via_escape.def"
+set_routing_layers -signal M2-M7
+pin_access -min_access_points 10000 -via_in_pin_bottom_layer M1 -via_in_pin_top_layer M1
+set points {}
+foreach ap [[ord::get_db_block] getAccessPoints] {
+  set mpin [$ap getMPin]
+  if {$mpin != "NULL" && [[$mpin getMTerm] getName] == "A" && [$ap hasAccess UP]} {
+    lappend points [$ap getPoint]
+  }
+}
+if {$points != {{45 81}}} {error "Expected short fixed via access: $points"}
+set report [make_result_file fixed_wire_short_via_escape.drc]
+drt::check_drc -output_file $report
+if {[file size $report] != 0} {error "Fixture has independent DRC violations"}
+puts "pass"
