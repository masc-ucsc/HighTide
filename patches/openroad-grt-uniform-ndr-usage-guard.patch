+
+bool Graph2D::usageWithinLimitWithUniformNDR(int x,
+                                             int y,
+                                             bool horizontal,
+                                             int limit,
+                                             int uniform_ndr_cost) const
+{
+  const auto& edge = horizontal ? h_edges_[x][y] : v_edges_[x][y];
+  if (edge.usage <= limit) {
+    return true;
+  }
+  if (uniform_ndr_cost <= 1 || edge.ndr_overflow == 0) {
+    return false;
+  }
+  const auto& nets = horizontal ? h_ndr_nets_[x][y] : v_ndr_nets_[x][y];
+  if (edge.ndr_overflow > nets.size()) {
+    return false;
+  }
+  for (const auto* net : nets) {
+    if (net->getEdgeCost() != uniform_ndr_cost) {
+      return false;
+    }
+  }
+  const int64_t penalty = int64_t(edge.ndr_overflow)
+                          * (kNDROverflowCostMultiplier - 1) * uniform_ndr_cost;
+  const int64_t demand = int64_t(edge.usage) - penalty;
+  return demand >= 0 && demand <= limit;
 }
 
