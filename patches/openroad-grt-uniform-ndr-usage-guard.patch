--- /dev/null
+++ b/src/grt/test/ndr_usage_guard_test.cpp
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include <array>
+#include <string>
+
+#include "Graph2D.h"
+#include "gtest/gtest.h"
+#include "odb/db.h"
+#include "utl/Logger.h"
+
+namespace grt {
+class NDRUsageGuard : public testing::Test
+{
+ protected:
+  odb::dbDatabase* db = nullptr;
+  odb::dbBlock* block = nullptr;
+  utl::Logger logger;
+  std::array<FrNet, 17> nets;
+  Graph2D graph;
+  void SetUp() override
+  {
+    db = odb::dbDatabase::create();
+    auto* tech = odb::dbTech::create(db, "tech");
+    block = odb::dbBlock::create(odb::dbChip::create(db, tech), "top");
+    graph.init(3, 3, 1, &logger);
+    graph.initCap3D();
+    graph.updateCap3D(0, 0, 0, EdgeDirection::Horizontal, 12);
+    graph.updateCap3D(0, 0, 0, EdgeDirection::Vertical, 12);
+    for (int i = 0; i < nets.size(); ++i) {
+      const int cost = i == 15 ? 1 : (i == 16 ? 4 : 3);
+      auto* net
+          = odb::dbNet::create(block, ("net" + std::to_string(i)).c_str());
+      nets[i].reset(
+          net, true, 0, cost, 0, 0, 0, new std::vector<int8_t>{int8_t(cost)});
+    }
+  }
+  void TearDown() override { odb::dbDatabase::destroy(db); }
+  void add(bool estimated)
+  {
+    for (int i = 0; i < 16; ++i) {
+      const int cost = nets[i].getEdgeCost();
+      if (estimated) {
+        graph.updateEstUsageH(0, 0, &nets[i], cost / 2.0);
+        graph.updateEstUsageH(0, 0, &nets[i], cost / 2.0);
+        graph.updateEstUsageV(0, 0, &nets[i], cost / 2.0);
+        graph.updateEstUsageV(0, 0, &nets[i], cost / 2.0);
+      } else {
+        graph.updateUsageH(0, 0, &nets[i], cost);
+        graph.updateUsageV(0, 0, &nets[i], cost);
+      }
+    }
+    if (estimated) {
+      graph.addEstUsageToUsage();
+    }
+  }
+};
+TEST_F(NDRUsageGuard, UniformPenaltyDoesNotChangeCostsOrHidePhysicalDemand)
+{
+  add(false);
+  EXPECT_EQ(graph.getNDROverflowH(0, 0), 11);
+  EXPECT_EQ(graph.getNDROverflowV(0, 0), 11);
+  EXPECT_EQ(graph.getUsageH(0, 0), 3313);
+  EXPECT_EQ(graph.getUsageV(0, 0), 3313);
+  for (bool horizontal : {true, false}) {
+    EXPECT_TRUE(
+        graph.usageWithinLimitWithUniformNDR(0, 0, horizontal, 3300, 3));
+    EXPECT_TRUE(graph.usageWithinLimitWithUniformNDR(0, 0, horizontal, 46, 3));
+    EXPECT_FALSE(graph.usageWithinLimitWithUniformNDR(0, 0, horizontal, 45, 3));
+    EXPECT_FALSE(
+        graph.usageWithinLimitWithUniformNDR(0, 0, horizontal, 3300, 2));
+    EXPECT_FALSE(
+        graph.usageWithinLimitWithUniformNDR(0, 0, horizontal, 3300, 0));
+  }
+  // This is a read-only guard: congestion penalties still guide maze routing.
+  EXPECT_EQ(graph.getUsageH(0, 0), 3313);
+  for (int i = 0; i < 16; ++i) {
+    graph.updateUsageH(0, 0, &nets[i], -nets[i].getEdgeCost());
+  }
+  EXPECT_EQ(graph.getUsageH(0, 0), 0);
+  EXPECT_EQ(graph.getNDROverflowH(0, 0), 0);
+  EXPECT_EQ(graph.getUsageV(0, 0), 3313);
+}
+TEST_F(NDRUsageGuard, EstimatedHalfRoutesAndStateCopiesKeepPenaltyCounts)
+{
+  add(true);
+  EXPECT_EQ(graph.getUsageH(0, 0), 3313);
+  Graph2D copied;
+  copied.init(3, 3, 1, &logger);
+  copied.initCap3D();
+  copied.copyRoutingStateFrom(graph, true);
+  EXPECT_TRUE(copied.usageWithinLimitWithUniformNDR(0, 0, true, 3300, 3));
+  EXPECT_FALSE(copied.usageWithinLimitWithUniformNDR(0, 0, true, 45, 3));
+}
+TEST_F(NDRUsageGuard, MixedCostsAndUnexplainedUsageKeepOriginalGuard)
+{
+  graph.addUsageH(1, 0, 5000);
+  EXPECT_FALSE(graph.usageWithinLimitWithUniformNDR(1, 0, true, 3300, 3));
+  add(false);
+  graph.updateUsageH(0, 0, &nets[16], 4);
+  EXPECT_FALSE(graph.usageWithinLimitWithUniformNDR(0, 0, true, 3300, 3));
+}
+}  // namespace grt
