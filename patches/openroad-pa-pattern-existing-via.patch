diff --git a/src/drt/test/fixed_wire_pattern_existing_via.tcl b/src/drt/test/fixed_wire_pattern_existing_via.tcl
--- /dev/null
+++ b/src/drt/test/fixed_wire_pattern_existing_via.tcl
@@ -0,0 +1,15 @@
+# A single legal access via must also produce a valid whole-cell pattern.
+read_lef "../../psm/test/asap7/asap7_tech_1x_201209.lef"
+read_lef "fixed_wire_pattern_existing_via.lef"
+read_def "fixed_wire_pattern_existing_via.def"
+set_routing_layers -signal M2-M7
+pin_access -min_access_points 10000 -via_in_pin_bottom_layer M1 -via_in_pin_top_layer M1
+set points {}
+foreach ap [[ord::get_db_block] getAccessPoints] {
+  set mpin [$ap getMPin]
+  if {$mpin != "NULL" && [[$mpin getMTerm] getName] == "A" && [$ap hasAccess UP]} {
+    lappend points [$ap getPoint]
+  }
+}
+if {$points != {{45 81}}} {error "Expected the sole existing fixed via access: $points"}
+puts "pass"
