+bool FlexPA::hasExistingFixedVia(const frVia* via, frBlockObject* owner) const
+{
+  bool existing_access_via = false;
+  if (owner->typeId() == frcNet && static_cast<frNet*>(owner)->isFixed()) {
+    std::vector<frBlockObject*> nearby;
+    getDesign()->getRegionQuery()->queryDRObj(
+        via->getBBox(), via->getViaDef()->getCutLayerNum(), nearby);
+    for (auto* obj : nearby) {
+      if (obj->typeId() != frcVia) {
+        continue;
+      }
+      const auto* existing = static_cast<frVia*>(obj);
+      if (existing->hasNet() && existing->getNet() == owner
+          && existing->getViaDef() == via->getViaDef()
+          && existing->getOrigin() == via->getOrigin()
+          && existing->getOrient() == via->getOrient()) {
+        existing_access_via = true;
+        break;
+      }
+    }
+  }
+  return existing_access_via;
+}
