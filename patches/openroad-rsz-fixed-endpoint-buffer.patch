+namespace {
+// Explicit handoff permission, separate from ordinary user dont_touch.
+// Only an input on an unfixed signal net may be reconnected. The instance
+// remains protected for sizing, cloning, deletion and all other operations.
+bool canReconnectFixedEndpoint(odb::dbObject* object)
+{
+  if (!object || object->getObjectType() != odb::dbITermObj) {
+    return false;
+  }
+  auto* pin = static_cast<odb::dbITerm*>(object);
+  auto* inst = pin->getInst();
+  auto* permission = odb::dbBoolProperty::find(
+      inst, "livehd_preroute_buffer_inputs_v1");
+  auto* net = pin->getNet();
+  if (!permission || !permission->getValue() || !inst->isDoNotTouch()
+      || !inst->isFixed() || pin->getIoType() != odb::dbIoType::INPUT
+      || !net || net->isDoNotTouch() || net->isSpecial()
+      || net->getSigType() != odb::dbSigType::SIGNAL) {
+    return false;
+  }
+  if (auto* wire = net->getWire()) {
+    odb::dbWireDecoder decoder;
+    decoder.begin(wire);
+    for (auto op = decoder.next(); op != odb::dbWireDecoder::END_DECODE;
+         op = decoder.next()) {
+      if ((op == odb::dbWireDecoder::PATH || op == odb::dbWireDecoder::SHORT
+           || op == odb::dbWireDecoder::JUNCTION)
+          && decoder.getWireType() == odb::dbWireType::FIXED) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+class FixedEndpointBufferScope
+{
+ public:
+  explicit FixedEndpointBufferScope(const std::vector<odb::dbObject*>& loads)
+  {
+    // Validate every protected load before relaxing any instance flag. This
+    // also rejects a mixed batch containing an immutable pin on the same cell.
+    for (auto* object : loads) {
+      if (!object || object->getObjectType() != odb::dbITermObj) {
+        continue;
+      }
+      auto* inst = static_cast<odb::dbITerm*>(object)->getInst();
+      if (inst->isDoNotTouch()) {
+        if (!canReconnectFixedEndpoint(object)) {
+          instances_.clear();
+          return;
+        }
+        if (std::find(instances_.begin(), instances_.end(), inst)
+            == instances_.end()) {
+          instances_.push_back(inst);
+        }
+      }
+    }
+    for (auto* inst : instances_) {
+      inst->setDoNotTouch(false);
+    }
+  }
+  ~FixedEndpointBufferScope()
+  {
+    for (auto* inst : instances_) {
+      inst->setDoNotTouch(true);
+    }
+  }
+  FixedEndpointBufferScope(const FixedEndpointBufferScope&) = delete;
+  FixedEndpointBufferScope& operator=(const FixedEndpointBufferScope&) = delete;
+
+ private:
+  std::vector<odb::dbInst*> instances_;
+};
+}  // namespace
+
+bool Resizer::canBufferLoad(const sta::Pin* pin) const
+{
+  return !dontTouch(pin) || canReconnectFixedEndpoint(db_network_->staToDb(pin));
+}
