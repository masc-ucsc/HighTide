diff --git a/src/rsz/test/fixed_endpoint_buffer.tcl b/src/rsz/test/fixed_endpoint_buffer.tcl
--- /dev/null
+++ b/src/rsz/test/fixed_endpoint_buffer.tcl
@@ -0,0 +1,60 @@
+try {
+source helpers.tcl
+source hi_fanout.tcl
+set file [make_result_file fixed_endpoint_buffer.def]
+write_hi_fanout_def $file 4
+read_liberty Nangate45/Nangate45_typ.lib
+read_lef Nangate45/Nangate45.lef
+read_def $file
+set block [ord::get_db_block]
+set inst [$block findInst load0]
+set other [$block findInst load1]
+foreach i [list $inst $other] {$i setPlacementStatus FIRM; $i setDoNotTouch true}
+set clock [$block findNet clk1]
+set wire [odb::dbWire_create $clock]
+set enc [odb::dbWireEncoder]
+$enc begin $wire
+$enc newPath [[ord::get_db_tech] findLayer metal2] FIXED
+$enc addPoint 1000 1000
+$enc addPoint 1000 2000
+$enc end
+rename $enc {}
+proc wire_state {wire} {
+ set result {}
+ for {set k 0} {$k < [$wire length]} {incr k} {lappend result [$wire getOpcode $k] [$wire getData $k]}
+ return $result
+}
+set encoded [wire_state $wire]
+proc state {inst} {return [list [[$inst getMaster] getName] [$inst getOrigin] [$inst getOrient] [$inst getPlacementStatus] [$inst isDoNotTouch]]}
+set original [state $inst]
+proc reject {pins} {
+ set block [ord::get_db_block]
+ set count [llength [$block getInsts]]
+ if {![catch {insert_buffer -buffer_cell BUF_X1 -load_pins $pins -buffer_name rejected}]} {error "Expected protected/malformed load rejection: $pins"}
+ if {[llength [$block getInsts]] != $count} {error "Rejected buffer mutated cell count"}
+}
+reject {load0/D}
+set prop [odb::dbBoolProperty_create $inst livehd_preroute_buffer_inputs_v1 false]
+reject {load0/D}
+$prop setValue true
+$inst setPlacementStatus PLACED
+reject {load0/D}
+$inst setPlacementStatus FIRM
+$clock setDoNotTouch true
+reject {load0/CK}
+$clock setDoNotTouch false
+# Even without the net flag, encoded FIXED geometry cannot be reconnected.
+reject {load0/CK}
+reject {load0/D load0/CK}
+set net [[$inst findITerm D] getNet]
+insert_buffer -buffer_cell BUF_X1 -load_pins {load0/D} -buffer_name permitted
+if {[[$inst findITerm D] getNet] eq $net || [state $inst] ne $original} {error "Ordinary input did not reconnect with protected state restored"}
+odb::dbBoolProperty_create $other livehd_preroute_buffer_inputs_v1 true
+# Distinct ordinary nets: API throws after scope construction. Flags must restore.
+reject {load0/D load1/D}
+if {![$inst isDoNotTouch] || ![$other isDoNotTouch]} {error "Exception lost instance protection"}
+insert_buffer -buffer_cell BUF_X1 -load_pins {load1/D load2/D} -buffer_name permitted_multi
+if {[[$other findITerm D] getNet] eq $net || ![$other isDoNotTouch]} {error "Multi-load insertion failed or lost protection"}
+if {[state $inst] ne $original || [wire_state $wire] ne $encoded} {error "Protected geometry changed"}
+puts "pass"
+} on error {message opts} {puts stderr "$message\n[dict get $opts -errorinfo]"; exit 1}
