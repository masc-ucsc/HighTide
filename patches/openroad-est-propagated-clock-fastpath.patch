+// ClkNetwork's ideal traversal skips propagated clocks entirely. Inspect the
+// constraints first so incremental RC updates after CTS need not reconstruct
+// the clock network just to discover that its ideal-pin set must be empty.
+// Do not cache this: set/unset_propagated_clock can change between updates.
+bool modeHasIdealClocks(const sta::Mode* mode)
+{
+  for (const sta::Clock* clock : mode->sdc()->clocks()) {
+    if (!clock->isPropagated()) {
+      return true;
+    }
+  }
+  return false;
+}
