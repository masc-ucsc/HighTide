+namespace psm {
+namespace {
+size_t components(const IRNetwork& network)
+{
+  std::unordered_map<Node*, std::vector<Node*>> adjacent;
+  for (const auto& [layer, nodes] : network.getNodes()) {
+    for (const auto& node : nodes) {
+      adjacent[node.get()];
+    }
+  }
+  for (const auto& edge : network.getConnections()) {
+    adjacent[edge->getNode0()].push_back(edge->getNode1());
+    adjacent[edge->getNode1()].push_back(edge->getNode0());
+  }
+  std::set<Node*> seen;
+  size_t count = 0;
+  for (const auto& [root, unused] : adjacent) {
+    if (!seen.insert(root).second) {
+      continue;
+    }
+    ++count;
+    std::vector<Node*> pending{root};
+    while (!pending.empty()) {
+      auto* node = pending.back();
+      pending.pop_back();
+      for (auto* next : adjacent.at(node)) {
+        if (seen.insert(next).second) {
+          pending.push_back(next);
+        }
+      }
+    }
+  }
+  return count;
+}
+
+class ViaConnectivity : public testing::Test
+{
+ protected:
+  utl::Logger logger;
+  odb::dbDatabase* db = nullptr;
+  odb::dbBlock* block = nullptr;
+  odb::dbTechLayer *lower = nullptr, *cut = nullptr, *upper = nullptr;
+  void SetUp() override
+  {
+    db = odb::dbDatabase::create();
+    auto* tech = odb::dbTech::create(db, "tech");
+    tech->setLefUnits(1000);
+    lower = odb::dbTechLayer::create(tech, "M1", odb::dbTechLayerType::ROUTING);
+    cut = odb::dbTechLayer::create(tech, "V1", odb::dbTechLayerType::CUT);
+    upper = odb::dbTechLayer::create(tech, "M2", odb::dbTechLayerType::ROUTING);
+    lower->setPitch(10);
+    upper->setPitch(10);
+    block = odb::dbBlock::create(odb::dbChip::create(db, tech), "top");
+    block->setDieArea(odb::Rect(0, 0, 100000, 100000));
+  }
+  void TearDown() override { odb::dbDatabase::destroy(db); }
+  odb::dbVia* via(bool split)
+  {
+    auto* via = odb::dbVia::create(block, "array");
+    for (auto* layer : {lower, upper}) {
+      if (split) {
+        odb::dbBox::create(via, layer, 0, 0, 10000, 40);
+        odb::dbBox::create(via, layer, 16000, 0, 25600, 40);
+      } else {
+        odb::dbBox::create(via, layer, 0, 0, 25600, 40);
+      }
+    }
+    for (int x = 10; x < 25600; x += 400) {
+      if (!split || x < 9900 || x > 16000) {
+        odb::dbBox::create(via, cut, x, 10, x + 10, 20);
+      }
+    }
+    return via;
+  }
+  odb::dbNet* install(odb::dbVia* via)
+  {
+    auto* net = odb::dbNet::create(block, "VDD");
+    net->setSigType(odb::dbSigType::POWER);
+    auto* wire = odb::dbSWire::create(net, odb::dbWireType::ROUTED);
+    odb::dbSBox::create(wire, via, 1000, 1000, odb::dbWireShapeType::STRIPE);
+    // A second translated instance exercises the definition cache. It remains
+    // disconnected: contracting the via must not connect separate instances.
+    odb::dbSBox::create(wire, via, 40000, 2000, odb::dbWireShapeType::STRIPE);
+    return net;
+  }
+};
+TEST_F(ViaConnectivity,
+       ContinuousPlatesContractAndElectricalRebuildRestoresNodes)
+{
+  auto* net = install(via(false));
+  IRNetwork full(net, &logger, false);
+  IRNetwork compact(net, &logger, false, true);
+  EXPECT_EQ(components(full), 2);
+  EXPECT_EQ(components(compact), components(full));
+  EXPECT_LT(compact.getNodes().at(lower).size(),
+            full.getNodes().at(lower).size());
+  compact.setConnectivityOnly(false);
+  compact.construct();
+  EXPECT_EQ(compact.getNodeCount(), full.getNodeCount());
+  EXPECT_EQ(compact.getConnections().size(), full.getConnections().size());
+}
+TEST_F(ViaConnectivity, SplitPlatesRetainDisconnectedComponents)
+{
+  auto* net = install(via(true));
+  IRNetwork full(net, &logger, false);
+  IRNetwork compact(net, &logger, false, true);
+  EXPECT_EQ(components(full), 4);
+  EXPECT_EQ(components(compact), components(full));
+  EXPECT_EQ(compact.getNodeCount(), full.getNodeCount());
+}
+TEST_F(ViaConnectivity, UnenclosedCutAndReconstructionInvalidateProof)
+{
+  auto* definition = via(false);
+  auto* net = install(definition);
+  IRNetwork compact(net, &logger, false, true);
+  odb::dbBox::create(definition, cut, 30000, 10, 30010, 20);
+  compact.construct();
+  IRNetwork full(net, &logger, false);
+  EXPECT_EQ(components(compact), components(full));
+  EXPECT_GT(components(compact), 2);
+  EXPECT_EQ(compact.getNodeCount(), full.getNodeCount());
+}
