+read_liberty Nangate45/Nangate45_typ.lib
+read_sdc Nangate45_data/gcd.sdc
+proc same_contents {left right} {
+  set f [open $left]; set a [read $f]; close $f
+  set f [open $right]; set b [read $f]; close $f
+  if {$a ne $b} {error "Electrical results differ: $left / $right"}
+}
+set direct_voltage [make_result_file direct.csv]
+set checked_voltage [make_result_file checked.csv]
+set direct_spice [make_result_file direct.sp]
+set checked_spice [make_result_file checked.sp]
+analyze_power_grid -net VDD -vsrc Vsrc_gcd_vdd.loc -voltage_file $direct_voltage
+write_pg_spice -net VDD -vsrc Vsrc_gcd_vdd.loc $direct_spice
+psm::clear_solvers
+check_power_grid -net VDD -dont_require_terminals
+analyze_power_grid -net VDD -vsrc Vsrc_gcd_vdd.loc -voltage_file $checked_voltage -allow_reuse
+# A check on an already solved network must retain the full network and solution.
+check_power_grid -net VDD -dont_require_terminals
+write_pg_spice -net VDD -vsrc Vsrc_gcd_vdd.loc $checked_spice
+same_contents $direct_voltage $checked_voltage
+same_contents $direct_spice $checked_spice
+puts "pass"
