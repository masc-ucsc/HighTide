+std::optional<IRNetwork::ViaContact> IRNetwork::connectivityContact(
+    odb::dbSBox* box)
+{
+  auto* via = box->getBlockVia();
+  if (!connectivity_only_ || via == nullptr) {
+    return std::nullopt;
+  }
+  auto [entry, inserted] = via_contacts_.try_emplace(via, std::nullopt);
+  if (!inserted) {
+    return entry->second;
+  }
+  auto* bottom = via->getBottomLayer();
+  auto* top = via->getTopLayer();
+  if (bottom == nullptr || top == nullptr || bottom == top) {
+    return std::nullopt;
+  }
+  std::vector<odb::dbShape> shapes;
+  box->getViaBoxes(shapes);
+  std::optional<odb::Rect> lower, upper;
+  for (const auto& shape : shapes) {
+    auto* layer = shape.getTechLayer();
+    if (layer->getRoutingLevel() == 0) {
+      continue;
+    }
+    if (layer != bottom && layer != top) {
+      return std::nullopt;
+    }
+    auto& plate = layer == bottom ? lower : upper;
+    if (plate) {
+      return std::nullopt;
+    }
+    plate = shape.getBox();
+  }
+  if (!lower || !upper) {
+    return std::nullopt;
+  }
+  std::optional<odb::Point> contact;
+  odb::dbTechLayer* cut_layer = nullptr;
+  int cuts = 0;
+  for (const auto& shape : shapes) {
+    auto* layer = shape.getTechLayer();
+    if (layer->getRoutingLevel() != 0) {
+      continue;
+    }
+    const auto& rect = shape.getBox();
+    const auto encloses = [&](const odb::Rect& plate) {
+      return plate.xMin() <= rect.xMin() && plate.yMin() <= rect.yMin()
+             && plate.xMax() >= rect.xMax() && plate.yMax() >= rect.yMax();
+    };
+    const int count = getEffectiveNumberOfCuts(shape);
+    if ((cut_layer && cut_layer != layer) || rect.dx() <= 0 || rect.dy() <= 0
+        || !encloses(*lower) || !encloses(*upper) || count <= 0
+        || cuts > std::numeric_limits<int>::max() - count) {
+      return std::nullopt;
+    }
+    cut_layer = layer;
+    cuts += count;
+    if (!contact) {
+      contact = rect.center();
+    }
+  }
+  if (contact) {
+    const auto origin = box->getViaXY();
+    entry->second = ViaContact{
+        odb::Point(contact->x() - origin.x(), contact->y() - origin.y()), cuts};
+  }
+  return entry->second;
+}
