+// Pointers in this heap all belong to the contiguous d1 grid. Epoch tags avoid
+// clearing the entire grid for each tree edge, without per-entry allocations.
+class HeapPositions
+{
+ public:
+  HeapPositions(double* base, size_t size) : base_(base), entries_(size) {}
+  int get(double* value) const
+  {
+    const auto& entry = entries_[value - base_];
+    return entry.epoch == epoch_ ? entry.index : -1;
+  }
+  void set(double* value, int index)
+  {
+    entries_[value - base_] = {index, epoch_};
+  }
+  void seed(double* value, int index)
+  {
+    set(value, get(value) == -1 ? index : duplicate_position);
+  }
+  void clear()
+  {
+    if (++epoch_ == 0) {
+      std::fill(entries_.begin(), entries_.end(), Entry{});
+      epoch_ = 1;
+    }
+  }
+ private:
+  struct Entry { int index = -1; uint32_t epoch = 0; };
+  double* base_;
+  std::vector<Entry> entries_;
+  uint32_t epoch_ = 1;
+};
