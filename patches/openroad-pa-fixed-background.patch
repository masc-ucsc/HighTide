diff --git a/src/drt/src/gc/FlexGC_init.cpp b/src/drt/src/gc/FlexGC_init.cpp
--- a/src/drt/src/gc/FlexGC_init.cpp
+++ b/src/drt/src/gc/FlexGC_init.cpp
@@ -219,7 +219,13 @@
       if (initDesign_skipObj(obj)) {
         continue;
       }
-      initObj(box, i, obj, false);
+      // Targeted PA checks import only immutable signal routes above. Treat
+      // those as background geometry, just like the existing pins/obstacles,
+      // so violations between two pre-existing shapes do not reject every
+      // proposed access. The candidate objects added by addPAObj remain
+      // non-fixed and are checked against this geometry. Full-design GC has
+      // no target objects and retains its original validation behavior.
+      initObj(box, i, obj, !targetObjs_.empty());
     }
   }
 }
