diff --git a/src/drt/test/fixed_wire_background_drc.tcl b/src/drt/test/fixed_wire_background_drc.tcl
--- /dev/null
+++ b/src/drt/test/fixed_wire_background_drc.tcl
@@ -0,0 +1,16 @@
+# Targeted PA ignores old background/background violations. Independent
+# full-design GC must still detect shorts between immutable signal traces.
+source "helpers.tcl"
+read_lef "../../psm/test/asap7/asap7_tech_1x_201209.lef"
+read_lef "../../psm/test/asap7/asap7sc7p5t_28_R_1x_220121a.lef"
+read_def "fixed_wire_background_drc.def"
+set drc_file [make_result_file fixed_wire_background_drc.drc]
+drt::check_drc -output_file $drc_file
+set file [open $drc_file r]
+set report [read $file]
+close $file
+if {![regexp {violation type: Short
+[[:space:]]+srcs: net:(n0 net:obstacle|obstacle net:n0)} $report]} {
+  error "Full-design GC failed to report the fixed/fixed short"
+}
+puts "pass"
