 namespace grt {
+namespace {
+// DEF imports can leave dbNet::getWireType() as ROUTED while the encoded
+// paths are FIXED. Inspect the actual paths before allowing an incremental
+// callback or congestion expansion to invalidate physical wiring.
+bool hasImmutableWire(odb::dbNet* net)
+{
+  auto* wire = net == nullptr ? nullptr : net->getWire();
+  if (wire == nullptr) {
+    return false;
+  }
+  odb::dbWireDecoder decoder;
+  decoder.begin(wire);
+  for (auto opcode = decoder.next(); opcode != odb::dbWireDecoder::END_DECODE;
+       opcode = decoder.next()) {
+    if (opcode != odb::dbWireDecoder::PATH
+        && opcode != odb::dbWireDecoder::SHORT
+        && opcode != odb::dbWireDecoder::JUNCTION) {
+      continue;
+    }
+    const auto type = decoder.getWireType();
+    if (type == odb::dbWireType::FIXED || type == odb::dbWireType::COVER) {
+      return true;
+    }
+  }
+  return false;
+}
+}  // namespace
