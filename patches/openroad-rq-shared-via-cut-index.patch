+void frRegionQuery::Impl::queryArrayCuts(
+    const odb::Rect& box, frLayerNum layer, Objects<frBlockObject>& result) const
+{
+  const auto& instances = arrayCuts.at(layer);
+  for (auto it = instances.qbegin(bgi::intersects(box)); it != instances.qend(); ++it) {
+    auto* via = it->second;
+    const auto xform = via->getTransform();
+    auto inverse = xform;
+    inverse.invert();
+    auto local = box;
+    inverse.apply(local);
+    const auto& cuts = masterCuts.at(via->getViaDef());
+    for (auto cut = cuts.qbegin(bgi::intersects(local)); cut != cuts.qend(); ++cut) {
+      auto exact = cut->first;
+      xform.apply(exact);
+      result.emplace_back(exact, via);
+    }
+  }
+}
