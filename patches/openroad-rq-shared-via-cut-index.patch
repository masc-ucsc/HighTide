@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#include <algorithm>
+#include <cstdint>
+#include <tuple>
+#include "fixture.h"
+#include "frRTree.h"
+
+namespace drt {
+class ArrayQueryFixture : public Fixture {};
+TEST_F(ArrayQueryFixture, ExactCutsMatchBruteForceAndReinitialization)
+{
+  router_cfg->VERBOSE = 0;
+  addLayer(design->getTech(), "v1", odb::dbTechLayerType::CUT);
+  addLayer(design->getTech(), "m2", odb::dbTechLayerType::ROUTING);
+  auto net = std::make_unique<frNet>("VDD", router_cfg.get());
+  std::vector<frVia*> instances;
+  for (int count : {1, 4, 100}) {
+    auto def = std::make_unique<frViaDef>(std::to_string(count));
+    def->addLayer1Fig(std::make_unique<frRect>(-10, -10, 210, 210, 2, nullptr));
+    def->addLayer2Fig(std::make_unique<frRect>(-10, -10, 210, 210, 4, nullptr));
+    for (int i = 0; i < count; ++i) {
+      const int x = (i % 10) * 20 - 100, y = (i / 10) * 20 - 100;
+      def->addCutFig(std::make_unique<frRect>(x, y, x + 6, y + 8, 3, nullptr));
+    }
+    auto* master = design->getTech()->addVia(std::move(def));
+    for (int offset : {-200, 0, 200}) {
+      auto via = std::make_unique<frVia>(master, odb::Point(offset, -offset));
+      instances.push_back(via.get());
+      net->addVia(std::move(via));
+    }
+  }
+  design->getTopBlock()->addSNet(std::move(net));
+  auto* rq = design->getRegionQuery();
+  using Key = std::tuple<int, int, int, int, uintptr_t>;
+  auto keys = [](const auto& objects) {
+    std::vector<Key> out;
+    for (const auto& [box, object] : objects) {
+      out.emplace_back(box.xMin(), box.yMin(), box.xMax(), box.yMax(),
+                       reinterpret_cast<uintptr_t>(object));
+    }
+    std::sort(out.begin(), out.end());
+    return out;
+  };
+  for (int generation = 0; generation < 2; ++generation) {
+    rq->init();
+    rq->initDRObj();
+    for (int x = -350; x < 350; x += 17) {
+      for (int y = -350; y < 350; y += 19) {
+        const odb::Rect query(x, y, x + 17, y + 19);
+        frRegionQuery::Objects<frBlockObject> expected, actual, boost_actual;
+        for (auto* via : instances) {
+          for (const auto& cut : via->getViaDef()->getCutFigs()) {
+            auto box = cut->getBBox();
+            via->getTransform().apply(box);
+            if (box.intersects(query)) expected.emplace_back(box, via);
+          }
+        }
+        rq->query(query, 3, actual);
+        box_t boost_box;
+        boost::geometry::convert(query, boost_box);
+        rq->query(boost_box, 3, boost_actual);
+        EXPECT_EQ(keys(expected), keys(actual));
+        EXPECT_EQ(keys(expected), keys(boost_actual));
+      }
+    }
+    frRegionQuery::Objects<frBlockObject> exhaustive;
+    rq->query(odb::Rect(-10000, -10000, 10000, 10000), 3, exhaustive);
+    EXPECT_EQ(exhaustive.size(), 3 * (1 + 4 + 100));
+    // Old envelopes must not survive rebuilding after placement changes.
+    instances.back()->setOrigin(odb::Point(400, 400));
+  }
+}
