diff --git a/src/grt/src/GlobalRouter.cpp b/src/grt/src/GlobalRouter.cpp
--- a/src/grt/src/GlobalRouter.cpp
+++ b/src/grt/src/GlobalRouter.cpp
@@ -460,6 +460,31 @@
       initCUGR(min_layer, max_layer);
     } else {
       initFastRoute(min_layer, max_layer);
+      // Reinitialization accounts for dbWires as obstructions, but clears
+      // FastRoute occupancy for guide-only nets in a partially routed design.
+      // Restore their resources and use the matching GRoute release path:
+      // the new FastRoute trees do not yet contain these routes.
+      std::vector<std::pair<odb::dbNet*, int>> ndr_nets;
+      for (const auto& [db_net, groute] : routes_) {
+        if (isDetailedRouted(db_net)) {
+          continue;
+        }
+        auto it = db_net_map_.find(db_net);
+        if (it == db_net_map_.end()) {
+          continue;
+        }
+        updateNetResources(it->second, false);
+        it->second->setAreSegmentsRestored(true);
+        if (db_net->getNonDefaultRule() != nullptr) {
+          int net_id;
+          bool exists;
+          fastroute_->getNetId(db_net, net_id, exists);
+          if (exists) {
+            ndr_nets.emplace_back(db_net, net_id);
+          }
+        }
+      }
+      disableCongestedNDRNetsFromRoutes(ndr_nets);
     }
   }
   grouter_cbk_ = new GRouteDbCbk(this);
