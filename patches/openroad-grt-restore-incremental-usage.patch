diff --git a/src/grt/test/incremental_pre_routed_usage.tcl b/src/grt/test/incremental_pre_routed_usage.tcl
--- /dev/null
+++ b/src/grt/test/incremental_pre_routed_usage.tcl
@@ -0,0 +1,29 @@
+# Mixed dbWire/global-guide occupancy must survive a no-op incremental route.
+source "pre_routed1.tcl"
+
+proc congestion_snapshot {} {
+  set grid [[ord::get_db_block] getGCellGrid]
+  set values {}
+  set nx [llength [$grid getGridX]]
+  set ny [llength [$grid getGridY]]
+  foreach layer [[ord::get_db_tech] getLayers] {
+    if {[$layer getRoutingLevel] == 0} { continue }
+    for {set x 0} {$x < $nx} {incr x} {
+      for {set y 0} {$y < $ny} {incr y} {
+        lappend values [$grid getUsage $layer $x $y]
+      }
+    }
+  }
+  return $values
+}
+
+set before [congestion_snapshot]
+for {set iteration 0} {$iteration < 2} {incr iteration} {
+  global_route -start_incremental
+  global_route -end_incremental
+  set after [congestion_snapshot]
+  check "mixed incremental iteration $iteration preserves every edge usage" {
+    expr {$before eq $after}
+  } 1
+}
+exit_summary
