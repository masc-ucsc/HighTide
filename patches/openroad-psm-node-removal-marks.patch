diff --git a/src/psm/src/node.h b/src/psm/src/node.h
--- a/src/psm/src/node.h
+++ b/src/psm/src/node.h
@@ -86,6 +86,7 @@
   odb::Point pt_;
   odb::dbTechLayer* layer_;
   bool visited_ = false;
+  bool cleanup_remove_ = false;
 };
 
 class SourceNode : public Node
diff --git a/src/psm/src/ir_network.cpp b/src/psm/src/ir_network.cpp
--- a/src/psm/src/ir_network.cpp
+++ b/src/psm/src/ir_network.cpp
@@ -1114,8 +1114,10 @@
 
   const std::size_t start_node_size = nodes.size();
 
-  // remove connections
+  // Mark before compaction to avoid a tree lookup for every surviving node.
+  // Marked nodes are destroyed below; surviving nodes keep the default false.
   for (auto* node : removes) {
+    node->cleanup_remove_ = true;
     for (auto* conn : node->cleanup_connections_) {
       conn->changeNode(node, nullptr);
     }
@@ -1123,9 +1125,14 @@
 
   // Compact in place: survivor order and node addresses are unchanged,
   // without allocating a temporary list entry for every node.
-  std::erase_if(nodes, [&](const auto& node) {
-    return removes.find(node.get()) != removes.end();
-  });
+  if (logger_->debugCheck(utl::PSM, "remove_node_marks", 1)) {
+    for (const auto& node : nodes) {
+      if (node->cleanup_remove_ != (removes.find(node.get()) != removes.end())) {
+        throw std::logic_error("Power-grid node removal mark differs from set");
+      }
+    }
+  }
+  std::erase_if(nodes, [](const auto& node) { return node->cleanup_remove_; });
 
   const std::size_t final_node_size = nodes.size();
 
