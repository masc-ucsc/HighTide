diff --git a/src/drt/test/fixed_wire_pin_access.tcl b/src/drt/test/fixed_wire_pin_access.tcl
--- /dev/null
+++ b/src/drt/test/fixed_wire_pin_access.tcl
@@ -0,0 +1,36 @@
+# A fixed M2 trace blocks two upward accesses on u0, but not on u1.
+# Both instances otherwise have the same master, orientation and track offsets.
+read_lef "../../psm/test/asap7/asap7_tech_1x_201209.lef"
+read_lef "../../psm/test/asap7/asap7sc7p5t_28_R_1x_220121a.lef"
+read_def "fixed_wire_pin_access.def"
+set_routing_layers -signal M2-M7
+pin_access -min_access_points 10000 -via_in_pin_bottom_layer M1 -via_in_pin_top_layer M1
+set block [ord::get_db_block]
+set u0 [$block findInst u0]
+set u1 [$block findInst u1]
+if {[$u0 getPinAccessIdx] == [$u1 getPinAccessIdx]} {
+  error "Fixed-wire environment incorrectly shares a pin-access pattern"
+}
+set counts [dict create]
+foreach ap [$block getAccessPoints] {
+  set mpin [$ap getMPin]
+  if {$mpin == "NULL" || ![$ap hasAccess UP]} { continue }
+  set key [list [[$mpin getMTerm] getName] [$ap getPoint]]
+  dict incr counts $key
+}
+foreach point {{45 81} {27 81}} {
+  if {[dict get $counts [list A $point]] != 1} {
+    error "Blocked access must exist only for the clear instance: $point"
+  }
+}
+foreach point {{45 189} {27 117} {27 153} {27 189}} {
+  if {[dict get $counts [list A $point]] != 2} {
+    error "Unaffected access lost: $point"
+  }
+}
+foreach point {{225 45} {225 225} {243 45} {243 81} {243 117} {243 153} {243 189} {243 225}} {
+  if {[dict get $counts [list Y $point]] != 2} {
+    error "Unaffected output access lost: $point"
+  }
+}
+puts "pass"
