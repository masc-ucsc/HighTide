diff --git a/src/grt/test/layer_overflow_positions_test.cpp b/src/grt/test/layer_overflow_positions_test.cpp
--- /dev/null
+++ b/src/grt/test/layer_overflow_positions_test.cpp
@@ -0,0 +1,50 @@
+#include "FastRoute.h"
+
+#include <utility>
+#include <vector>
+
+#include "gtest/gtest.h"
+#include "odb/db.h"
+
+TEST(FastRouteOverflow, FindsLayerOverflowWithSparePlanarCapacity)
+{
+  auto* db = odb::dbDatabase::create();
+  auto* tech = odb::dbTech::create(db, "test_tech");
+  auto* chip = odb::dbChip::create(db, tech);
+  auto* block = odb::dbBlock::create(chip, "test");
+  auto* net = odb::dbNet::create(block, "signal");
+  {
+    grt::FastRouteCore router(db, nullptr, nullptr, nullptr, nullptr);
+    router.setGridsAndLayers(3, 3, 4);
+    router.initEdges();
+    router.addNet(net, false, false, 0, 1, 0, 3, 0.0, nullptr);
+    // Aggregate capacity is 11 in either direction, but the first layer
+    // of each direction can only accommodate one of the two tracks used.
+    router.setEdgeCapacity(0, 0, 1, 0, 1, 1);
+    router.setEdgeCapacity(0, 0, 1, 0, 3, 10);
+    router.setEdgeCapacity(1, 0, 1, 1, 2, 1);
+    router.setEdgeCapacity(1, 0, 1, 1, 4, 10);
+    router.updateEdge2DAnd3DUsage(0, 0, 1, 0, 1, 2, net);
+    router.updateEdge2DAnd3DUsage(1, 0, 1, 1, 2, 2, net);
+    std::vector<std::pair<odb::Point, bool>> positions;
+    router.getOverflowPositions(positions);
+    ASSERT_EQ(positions.size(), 2);
+    EXPECT_EQ(positions[0], std::make_pair(odb::Point(0, 0), true));
+    EXPECT_EQ(positions[1], std::make_pair(odb::Point(1, 0), false));
+
+    // Multiple overflowing layers at one planar location are not duplicates.
+    router.updateEdge2DAnd3DUsage(0, 0, 1, 0, 3, 11, net);
+    positions.clear();
+    router.getOverflowPositions(positions);
+    EXPECT_EQ(positions.size(), 2);
+
+    // Released routes must not leave stale overflow locations behind.
+    router.updateEdge2DAnd3DUsage(0, 0, 1, 0, 1, -2, net);
+    router.updateEdge2DAnd3DUsage(0, 0, 1, 0, 3, -11, net);
+    router.updateEdge2DAnd3DUsage(1, 0, 1, 1, 2, -2, net);
+    positions.clear();
+    router.getOverflowPositions(positions);
+    EXPECT_TRUE(positions.empty());
+  }
+  odb::dbDatabase::destroy(db);
+}
