diff --git a/src/drt/test/current_db_drc.tcl b/src/drt/test/current_db_drc.tcl
--- /dev/null
+++ b/src/drt/test/current_db_drc.tcl
@@ -0,0 +1,37 @@
+source "helpers.tcl"
+read_lef "../../psm/test/asap7/asap7_tech_1x_201209.lef"
+read_def "current_db_drc.def"
+set_routing_layers -signal M2-M7
+proc check_report {tag expect_corner} {
+  set path [make_result_file "current_db_drc_${tag}.drc"]
+  drt::check_drc -output_file $path
+  set stream [open $path r]
+  set text [read $stream]
+  close $stream
+  if {[string match {*Corner Spacing*} $text] != $expect_corner} {
+    error "Unexpected corner result for $tag: $text"
+  }
+  return $text
+}
+check_report before 0
+set wire [[[ord::get_db_block] findNet moving] getWire]
+set enc [odb::dbWireEncoder]
+proc replace_route {patch} {
+  global enc wire
+  $enc begin $wire
+  $enc newPath [[ord::get_db_tech] findLayer M2] ROUTED
+  $enc addPoint 1536 1036
+  $enc addPoint 1590 1036
+  if {$patch} {
+    $enc newPath [[ord::get_db_tech] findLayer M2] ROUTED
+    $enc addPoint 1536 1036
+    $enc addRect -32 -9 -14 9
+  }
+  $enc end
+}
+replace_route 1
+set first [check_report added 1]
+if {$first ne [check_report repeated 1]} {error "Repeated DRC changed"}
+replace_route 0
+if {[check_report removed 0] ne ""} {error "Removed patch still present"}
+puts "pass"
